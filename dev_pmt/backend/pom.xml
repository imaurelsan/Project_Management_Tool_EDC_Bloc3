<?xml version="1.0" encoding="UTF-8"?>
<!--
    Fichier de configuration Maven du backend PMT (Project Management Tool).
    Il décrit le projet, ses dépendances et la manière de le compiler et de le packager.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Projet parent Spring Boot : il fournit les versions compatibles
        de toutes les bibliothèques, ce qui évite de les gérer une à une.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <!-- Vide : le parent est récupéré depuis le dépôt Maven, pas depuis le disque -->
        <relativePath />
    </parent>

    <!-- Identifiants Maven du projet -->
    <groupId>com.pmt</groupId>
    <artifactId>pmtbackend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>pmtbackend</name>
    <description>Backend de l'outil de gestion de projet PMT</description>

    <properties>
        <!-- Version de Java utilisée pour compiler le code -->
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- Serveur web (Tomcat intégré) et API REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Accès à la base de données via JPA / Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation des données entrantes (annotations @NotNull, @Size, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Envoi d'e-mails (JavaMailSender) : utilisé pour notifier l'assignation d'une tâche -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Pilote JDBC pour MySQL. "runtime" : nécessaire à l'exécution, pas à la compilation -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok : génère automatiquement getters, setters, constructeurs. Pas embarqué dans le JAR final -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Bibliothèques de test : JUnit, Mockito, AssertJ, Spring Boot Test. Utilisées uniquement lors des tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Base de données en mémoire, utilisée uniquement pour les tests d'intégration -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Autres dépendances -->

        <!-- Outils de chiffrement (hachage des mots de passe, par exemple BCrypt) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Plugin Spring Boot : permet de lancer l'application (mvnw spring-boot:run)
                et de créer le JAR exécutable (mvnw package).
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Classe contenant la méthode main() de l'application -->
                    <mainClass>com.pmt.pmtbackend.PmtbackendApplication</mainClass>
                    <!-- Lombok est utilisé à la compilation seulement : on l'exclut du JAR final -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>